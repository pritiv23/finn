# One key is enough. Without any, FINN runs in deterministic mode:
# every number, chart, flag and classification still works; filing one-liners
# fall back to the exchange's own text and the transcript analysis is skipped.

GROQ_API_KEY=            # https://console.groq.com — free tier
# GEMINI_API_KEY=        # https://aistudio.google.com — free tier

# Optional overrides
# FINN_LLM_PROVIDER=groq            # groq | gemini | custom
# FINN_FAST_MODEL=llama-3.1-8b-instant
# FINN_SMART_MODEL=llama-3.3-70b-versatile
# FINN_SKIP_AR=1                    # skip annual-report reading (faster)
